# ---- Password-reset e-mails (needed on a deployed site; locally the code is printed in the terminal) ----
# Gmail: turn on 2-Step Verification, create an "App password" and use it as SMTP_PASS.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SkillRoute <your-email@gmail.com>"

